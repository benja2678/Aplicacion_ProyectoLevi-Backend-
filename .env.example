# ------------------------------------------------------------------
# Variables para usar el backend EN TU PC (sin Docker).
# Copia este archivo con el nombre .env (en esta misma carpeta) y completa los valores.
# El archivo .env NO se sube a git (está en .gitignore).
#
# Para el servidor con Docker se usa otro archivo: deploy/.env (ver deploy/.env.example).
#
# Para generar valores aleatorios seguros:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
# ------------------------------------------------------------------

# true solo en tu PC (muestra errores detallados). En el servidor SIEMPRE false.
DEBUG=true

# Llave interna de Django (firma los tokens). Larga y aleatoria.
SECRET_KEY=cambia-esto-por-un-valor-aleatorio

# Direcciones desde las que se puede usar el backend, separadas por comas.
ALLOWED_HOSTS=localhost,127.0.0.1

# Llave que Unity envía en el encabezado X-Api-Key. Solo sirve para enviar sesiones.
UNITY_API_KEY=cambia-esto-por-otro-valor-aleatorio

# Cuenta del profesor (se crea con: python manage.py ensure_teacher).
# Mínimo 10 caracteres, que no sea solo números ni una clave común.
TEACHER_USERNAME=profesor
TEACHER_PASSWORD=cambia-esta-clave
TEACHER_EMAIL=

# Base de datos: si POSTGRES_HOST está vacío se usa SQLite (archivo db.sqlite3).
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=laboratorio
POSTGRES_USER=laboratorio
POSTGRES_PASSWORD=

# Opcionales (estos son los valores por defecto)
# JWT_ACCESS_MINUTES=30      duración del token de acceso
# JWT_REFRESH_HOURS=8        tiempo máximo antes de tener que iniciar sesión otra vez
# LOGIN_RATE=5/min           intentos de login permitidos por IP
# MAX_UPLOAD_MB=50           tamaño máximo de una petición (sesiones grandes)
# TIME_ZONE=America/Santiago

# ------------------------------------------------------------------
# Entorno de DESARROLLO (ENTORNO=dev, el que se usa por defecto).
# Copia este archivo con el nombre .env.dev (en esta misma carpeta) y completa
# los valores. El archivo .env.dev NO se sube a git (está en .gitignore).
#
# Para el entorno de producción se usa .env.prod (ver .env.prod.example).
#
# Para generar valores aleatorios seguros:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
# ------------------------------------------------------------------

# true en desarrollo (muestra errores detallados). En producción SIEMPRE false.
DEBUG=true

# Llave interna de Django (firma los tokens). Larga y aleatoria.
SECRET_KEY=cambia-esto-por-un-valor-aleatorio

# Direcciones desde las que se puede usar el backend, separadas por comas.
ALLOWED_HOSTS=localhost,127.0.0.1

# Llave que Unity envía en el encabezado X-Api-Key. Solo sirve para enviar sesiones.
UNITY_API_KEY=cambia-esto-por-otro-valor-aleatorio

# Cuenta del profesor (se crea con: python manage.py ensure_teacher).
# Mínimo 10 caracteres, que no sea solo números ni una clave común.
TEACHER_USERNAME=profesor
TEACHER_PASSWORD=cambia-esta-clave
TEACHER_EMAIL=

# Base de datos PostgreSQL de DESARROLLO (la del servidor).
# Debe tener las tablas de levi-db-scripts (v2.0, v2.1, v2.2 y v2.3, en ese orden).
POSTGRES_HOST=cambia-esto
POSTGRES_PORT=5432
POSTGRES_DB=levi_dev
POSTGRES_USER=levi_dev
POSTGRES_PASSWORD=cambia-esto
# POSTGRES_SSLMODE=require     si el servidor exige conexión cifrada

# Tests (python manage.py test lab): crean una base aparte, test_<POSTGRES_DB>, y la
# borran al terminar. El usuario necesita permiso para crear bases (CREATEDB).
# POSTGRES_TEST_DB=test_levi_dev
# Carpeta del repositorio levi-db-scripts (por defecto: ../levi-db-scripts).
# LEVI_DB_SCRIPTS=C:\ruta\a\levi-db-scripts

# Opcionales (estos son los valores por defecto)
# JWT_ACCESS_MINUTES=30      duración del token de acceso
# JWT_REFRESH_HOURS=8        tiempo máximo antes de tener que iniciar sesión otra vez
# LOGIN_RATE=5/min           intentos de login permitidos por IP
# MAX_UPLOAD_MB=50           tamaño máximo de una petición (sesiones grandes)
# TIME_ZONE=America/Santiago

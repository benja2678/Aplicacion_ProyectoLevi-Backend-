# ------------------------------------------------------------------
# Variables del sistema completo con Docker (servidor o tu PC con Docker Desktop).
#
#   cp .env.example .env      y luego edita .env con los valores reales.
#
# El archivo .env NO se sube a git (está en .gitignore).
#
# Para generar valores aleatorios (en el servidor, Linux):
#   openssl rand -hex 32
# Usa solo letras y números: los símbolos como $ o # pueden romper el archivo.
# ------------------------------------------------------------------

# IP o dominio del servidor (lo que se escribe en el navegador y en Unity),
# separados por comas. Ejemplo: 203.0.113.10,laboratorio.uta.cl
ALLOWED_HOSTS=localhost,127.0.0.1

# Llave interna de Django (firma los tokens del login). Larga y aleatoria.
SECRET_KEY=cambia-esto

# Llave que Unity envía en el encabezado X-Api-Key. Solo sirve para enviar sesiones.
# Es la misma que se pone en el asset EnvioSesiones de Unity.
UNITY_API_KEY=cambia-esto

# Base de datos PostgreSQL.
# OJO: la contraseña solo se usa la PRIMERA vez que se crea la base de datos.
# Si después la cambias aquí, el backend ya no podrá conectarse.
POSTGRES_DB=laboratorio
POSTGRES_USER=laboratorio
POSTGRES_PASSWORD=cambia-esto

# Puerto donde se abre la página web. 80 es el normal (http://IP-del-servidor/).
# Cámbialo solo si el 80 ya está ocupado (ej. 8080 -> http://IP:8080/).
HTTP_PORT=80

# ---- Opcionales (estos son los valores por defecto) ----
# Si el sitio se usa con https o con un puerto distinto de 80, para el panel /admin/:
# CSRF_TRUSTED_ORIGINS=https://laboratorio.uta.cl
# HTTPS=false               true solo cuando el servidor tenga certificado https
# NUM_PROXIES=1             2 si hay OTRO proxy delante de este Nginx
# WEB_CONCURRENCY=3         procesos de gunicorn
# JWT_ACCESS_MINUTES=30     duración del token de acceso
# JWT_REFRESH_HOURS=8       tiempo máximo antes de tener que iniciar sesión otra vez
# LOGIN_RATE=5/min          intentos de login permitidos por IP
# TIME_ZONE=America/Santiago

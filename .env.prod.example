# ------------------------------------------------------------------
# Entorno de PRODUCCIÓN (ENTORNO=prod).
# Copia este archivo con el nombre .env.prod (en esta misma carpeta) y completa
# los valores. El archivo .env.prod NO se sube a git (está en .gitignore).
#
# Para usarlo en tu PC (PowerShell):
#   $env:ENTORNO = 'prod'; .venv\Scripts\python manage.py runserver
#
# Para generar valores aleatorios seguros:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
# ------------------------------------------------------------------

# En producción SIEMPRE false.
DEBUG=false

# Llave interna de Django (firma los tokens). Larga, aleatoria y DISTINTA a la de dev.
SECRET_KEY=cambia-esto

# IP o dominio del servidor, separados por comas.
ALLOWED_HOSTS=cambia-esto

# Llave que Unity envía en el encabezado X-Api-Key. Distinta a la de dev.
UNITY_API_KEY=cambia-esto

# Base de datos PostgreSQL de PRODUCCIÓN (la del servidor).
# Debe tener las tablas de levi-db-scripts (v2.0, v2.1, v2.2 y v2.3, en ese orden).
POSTGRES_HOST=cambia-esto
POSTGRES_PORT=5432
POSTGRES_DB=levi_prod
POSTGRES_USER=levi_prod
POSTGRES_PASSWORD=cambia-esto
# POSTGRES_SSLMODE=require     si el servidor exige conexión cifrada

# Opcionales (estos son los valores por defecto)
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_HOURS=8
# LOGIN_RATE=5/min
# MAX_UPLOAD_MB=50
# TIME_ZONE=America/Santiago
